<mujoco model="UR5e and RH8D scene">
  <include file="ur5e_rh8d.xml"/>

  <statistic center="0.3 0 0.4" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Use this pose for cylinder, when robotic arm is present on the ground (no table): <body name="cylinder" pos="1.06 0.975 0.70"> --> 
    
    <!-- NOTE:
    Use this for Cartesian Planning - horizontally pushing the cylinder to it's holder: 
    <body name="cylinder" pos="0.398 -0.348 0.799"> 
    -->

    <!-- Use this for normal pick and place: <body name="cylinder" pos="0.478 -0.332 0.799"> -->

    <!-- Use this for pick and place when the arm is manually taken to cylinder pick pose: <body name="cylinder" pos="0.49 -0.348 0.791"> -->

    <body name="cylinder" pos="0.475 -0.34 0.799">
      <!-- <freejoint/> -->
      <!-- <inertial pos="0 0 0"
                mass="0.45"
                diaginertia="0.00091 0.00091 0.00014"/> -->
      <!-- <geom name="cylinder"
            type="cylinder"
            size="0.025 0.075"
            rgba="0.1 0.6 0.1 1"
            friction="0.4 0.05 0.05"
            solref="0.001 1"
            solimp="0.95 0.999 0.001"
            contype="4" conaffinity="3" condim="6"/> -->
      <inertial pos="0 0 0"
          mass="0.45"
          diaginertia="0.00091 0.00091 0.00014"/>
      <geom name="cylinder"
      type="cylinder"
      size="0.030 0.075"
      rgba="0.1 0.6 0.1 1"
      friction="1.5 0.08 0.005"
      solref="0.025 1"
      solimp="0.85 0.95 0.001"
      contype="4" conaffinity="3" condim="4"/>
      
    </body>

    <body name="place_platform_cylinder" pos="0.61 -0.435 0.73">
      <geom name="place_platform_cylinder"
            type="box"
            size="0.04 0.04 0.0001"
            rgba="1 0.1 0.1 1"
            friction="0.8 0.1 0.1"
            contype="4"
            conaffinity="3"
            condim="6"/>
    </body>

    <body name="cylinder_holder" pos="0.160 -0.352 0.799">
      <geom name="holder_left" type="box"
            pos="0 0.032 0"
            size="0.03 0.003 0.08"
            rgba="0.7 0.4 0.2 1"/>

      <geom name="holder_right" type="box"
            pos="0 -0.032 0"
            size="0.03 0.003 0.08"
            rgba="0.7 0.4 0.2 1"/>

      <geom name="holder_back" type="box"
            pos="-0.03 0 0"
            size="0.003 0.035 0.08"
            rgba="0.7 0.4 0.2 1"/>
    </body>

    <!-- Use this pose for the tennis ball, when using, tennis ball pose from the moveit 
         SRDF file:     pos="0.8325 -0.335 0.799" -->

    <body name="tennis_ball" pos="0.816 -0.335 0.799">
      <freejoint/>
      <inertial pos="0 0 0"
            mass="0.06"
            diaginertia="0.00002614 0.00002614 0.00002614"/>
      <geom name="tennis_ball" type="sphere" size="0.033"  
            rgba="0.6 0.2 0.8 1"      
            friction="0.95 0.225 0.225"
            solref="0.003 1"
            solimp="0.90 0.97 0.001"
            contype="4" conaffinity="3" condim="6"/>
    </body>

    <body name="place_platform_ball" pos="0.52 -0.435 0.73">
      <geom name="place_platform_ball"
            type="cylinder"
            size="0.04 0.0001"
            rgba="1 0.1 0.1 1"
            friction="0.8 0.1 0.1"
            contype="4"
            conaffinity="3"
            condim="6"/>
    </body>

  </worldbody>
</mujoco>
