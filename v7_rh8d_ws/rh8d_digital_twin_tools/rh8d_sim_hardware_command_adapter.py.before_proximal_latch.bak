#!/usr/bin/env python3

import math
import rclpy
from rclpy.node import Node

from std_msgs.msg import Float64MultiArray
from trajectory_msgs.msg import JointTrajectory, JointTrajectoryPoint
from sensor_msgs.msg import JointState
from hand_sensors_interfaces.msg import FTS3Sensors


HARDWARE_ORDER = [
    "forearm:1--base:1",
    "palm_axis:1--forearm:1",
    "palm_assembly:1--palm_axis:1",
    "thumb_adduction_motor",
    "thumb_flexion_motor",
    "index_flexion_motor",
    "middle_flexion_motor",
    "ring_small_flexion_motor",
]

SIM_JOINT_ORDER = [
    "forearm:1--base:1",
    "palm_axis:1--forearm:1",
    "palm_assembly:1--palm_axis:1",
    "Thumb_axis--palm_assembly:1",

    "Thumb_Methacarpal--Thumb_axis",
    "Thumb_Proximal--Thumb_Methacarpal",
    "Thumb_Distal--Thumb_Proximal",

    "Index_Proximal--palm_assembly:1",
    "Index_Middle--Index_Proximal",
    "Index_Distal--Index_Middle",

    "Middle_Proximal--palm_assembly:1",
    "Middle_Middle--Middle_Proximal",
    "Middle_Distal--Middle_Middle",

    "Ring_Proximal--palm_assembly:1",
    "Ring_Middle--Ring_Proximal",
    "Ring_Distal--Ring_Middle",

    "Small_Proximal--palm_assembly:1",
    "Small_Middle--Small_Proximal",
    "Small_Distal--Small_Middle",
]

DEFAULT_OPEN_HW = [
    2052.0,
    2010.0,
    2191.0,
    3971.0,
    100.0,
    100.0,
    100.0,
    0.0,
]

FINGER_HW_INDEX = {
    "thumb": 4,
    "index": 5,
    "middle": 6,
    "ring": 7,
    "small": 7,
}

FINGER_JOINTS = {
    "thumb": (
        "Thumb_Methacarpal--Thumb_axis",
        "Thumb_Proximal--Thumb_Methacarpal",
        "Thumb_Distal--Thumb_Proximal",
    ),
    "index": (
        "Index_Proximal--palm_assembly:1",
        "Index_Middle--Index_Proximal",
        "Index_Distal--Index_Middle",
    ),
    "middle": (
        "Middle_Proximal--palm_assembly:1",
        "Middle_Middle--Middle_Proximal",
        "Middle_Distal--Middle_Middle",
    ),
    "ring": (
        "Ring_Proximal--palm_assembly:1",
        "Ring_Middle--Ring_Proximal",
        "Ring_Distal--Ring_Middle",
    ),
    "small": (
        "Small_Proximal--palm_assembly:1",
        "Small_Middle--Small_Proximal",
        "Small_Distal--Small_Middle",
    ),
}

# Tuning parameters
CONTROL_HZ = 20.0
DT = 1.0 / CONTROL_HZ

FREE_CLOSE_RATE_TICKS = 550.0       # normal closing speed
CONTACT_CLOSE_RATE_TICKS = 120.0    # slower after contact
RELAX_RATE_TICKS = 700.0            # relax if contact force is too high

CONTACT_FORCE_N = 1.0               # start compliance
HARD_FORCE_N = 12.0                 # relax if force is too high
EXTREME_FORCE_N = 40.0              # stronger relaxation

PROXIMAL_YIELD_MARGIN = 0.02        # rad
PROXIMAL_RELAX_MARGIN = 0.08        # rad


def clamp(x, lo, hi):
    return max(lo, min(hi, x))


def move_towards(current, target, max_step):
    if current < target:
        return min(current + max_step, target)
    if current > target:
        return max(current - max_step, target)
    return current


def clamp_mapping(value, in_min, in_max, out_min, out_max):
    if value < in_min:
        return out_min
    if value > in_max:
        return out_max
    return (value - in_min) * (out_max - out_min) / (in_max - in_min) + out_min


def wrist_rotation_ticks_to_rad(tick):
    return clamp_mapping(tick, 0.0, 4095.0, -math.pi / 2.0, math.pi / 2.0)


def wrist_adduction_ticks_to_rad(tick):
    return clamp_mapping(tick, 0.0, 4095.0, -math.pi / 4.0, math.pi / 4.0)


def wrist_flexion_ticks_to_rad(tick):
    return clamp_mapping(tick, 0.0, 4095.0, -math.pi / 4.0, math.pi / 4.0)


def thumb_adduction_ticks_to_rad(tick):
    return clamp_mapping(tick, 0.0, 4095.0, 0.0, math.pi / 2.0)


def normal_finger_stages(tick):
    proximal = clamp_mapping(tick, 0.0, 2000.0, 0.0, math.pi / 2.0)
    middle = clamp_mapping(tick, 2000.0, 3800.0, 0.0, math.pi / 2.0)
    distal = clamp_mapping(tick, 3800.0, 4095.0, 0.0, math.pi / 4.0)
    return proximal, middle, distal


def thumb_finger_stages(tick):
    # Hardware broadcaster behavior:
    # thumb PIP closes in first stage, thumb MCP in second stage, DIP in third stage.
    thumb_mcp = clamp_mapping(tick, 2000.0, 3800.0, 0.0, math.pi / 2.0)
    thumb_pip = clamp_mapping(tick, 0.0, 2000.0, 0.0, math.pi / 2.0)
    thumb_dip = clamp_mapping(tick, 3800.0, 4095.0, 0.0, math.pi / 4.0)
    return thumb_mcp, thumb_pip, thumb_dip


class RH8DCompliantCommandAdapter(Node):
    def __init__(self):
        super().__init__("rh8d_sim_hardware_command_adapter")

        self.desired_hw = list(DEFAULT_OPEN_HW)
        self.current_hw = list(DEFAULT_OPEN_HW)

        self.latest_force = {
            "thumb": 0.0,
            "index": 0.0,
            "middle": 0.0,
            "ring": 0.0,
            "small": 0.0,
        }

        self.filtered_force = dict(self.latest_force)

        self.latest_joint_pos = {name: 0.0 for name in SIM_JOINT_ORDER}

        self.create_subscription(
            Float64MultiArray,
            "/rh8dr/hand_position_controller/commands",
            self.command_callback,
            10,
        )

        self.create_subscription(
            FTS3Sensors,
            "/rh8dr/fts_broadcaster/fingertip_force_sensors",
            self.force_callback,
            10,
        )

        self.create_subscription(
            JointState,
            "/joint_states",
            self.joint_state_callback,
            10,
        )

        self.pub = self.create_publisher(
            JointTrajectory,
            "/hand_trajectory_controller/joint_trajectory",
            10,
        )

        self.timer = self.create_timer(DT, self.control_loop)

        self.get_logger().info("RH8D force-aware compliant staged adapter started.")
        self.get_logger().info("Input command: /rh8dr/hand_position_controller/commands")
        self.get_logger().info("Input force:   /rh8dr/fts_broadcaster/fingertip_force_sensors")
        self.get_logger().info("Output:        /hand_trajectory_controller/joint_trajectory")

    def command_callback(self, msg):
        if len(msg.data) < 8:
            self.get_logger().warn(f"Expected 8 values, got {len(msg.data)}. Ignoring.")
            return

        self.desired_hw = [float(v) for v in msg.data[:8]]

        self.get_logger().info(
            "New desired hardware command: "
            f"thumb={self.desired_hw[4]:.0f}, "
            f"index={self.desired_hw[5]:.0f}, "
            f"middle={self.desired_hw[6]:.0f}, "
            f"ring/small={self.desired_hw[7]:.0f}"
        )

    def force_callback(self, msg):
        for name, norm in zip(msg.motor_names, msg.norm_forces):
            if name in self.latest_force:
                self.latest_force[name] = float(norm)

        # Ring and small share one hardware motor, so use the larger contact.
        ring_small_force = max(
            self.latest_force.get("ring", 0.0),
            self.latest_force.get("small", 0.0),
        )
        self.latest_force["ring"] = ring_small_force
        self.latest_force["small"] = ring_small_force

        # Low-pass filter to avoid reacting violently to one-sample spikes.
        alpha = 0.25
        for name in self.filtered_force:
            self.filtered_force[name] = (
                (1.0 - alpha) * self.filtered_force[name]
                + alpha * self.latest_force[name]
            )

    def joint_state_callback(self, msg):
        for name, pos in zip(msg.name, msg.position):
            if name in self.latest_joint_pos:
                self.latest_joint_pos[name] = float(pos)

    def update_virtual_motor_ticks(self):
        # Wrist/palm can follow normally.
        for i in range(4):
            self.current_hw[i] = move_towards(
                self.current_hw[i],
                self.desired_hw[i],
                FREE_CLOSE_RATE_TICKS * DT,
            )

        # Fingers are force-aware.
        for finger in ["thumb", "index", "middle", "ring"]:
            idx = FINGER_HW_INDEX[finger]
            force = self.filtered_force.get(finger, 0.0)

            if force >= EXTREME_FORCE_N:
                # Strong relaxation when MuJoCo creates a big contact spike.
                self.current_hw[idx] = max(
                    0.0,
                    self.current_hw[idx] - RELAX_RATE_TICKS * DT,
                )
            elif force >= HARD_FORCE_N:
                # Relax gently.
                self.current_hw[idx] = max(
                    0.0,
                    self.current_hw[idx] - 0.5 * RELAX_RATE_TICKS * DT,
                )
            elif force >= CONTACT_FORCE_N:
                # Continue closing, but slowly. This allows middle/distal to wrap.
                self.current_hw[idx] = move_towards(
                    self.current_hw[idx],
                    self.desired_hw[idx],
                    CONTACT_CLOSE_RATE_TICKS * DT,
                )
            else:
                # Free-space motion.
                self.current_hw[idx] = move_towards(
                    self.current_hw[idx],
                    self.desired_hw[idx],
                    FREE_CLOSE_RATE_TICKS * DT,
                )

        self.current_hw[7] = clamp(self.current_hw[7], 0.0, 4095.0)

    def apply_joint_compliance(self, finger, prox, mid, dist):
        force = self.filtered_force.get(finger, 0.0)
        prox_name, mid_name, dist_name = FINGER_JOINTS[finger]

        actual_prox = self.latest_joint_pos.get(prox_name, prox)
        actual_mid = self.latest_joint_pos.get(mid_name, mid)
        actual_dist = self.latest_joint_pos.get(dist_name, dist)

        if force >= EXTREME_FORCE_N:
            # Very high force: relax all targets slightly.
            prox = min(prox, actual_prox - PROXIMAL_RELAX_MARGIN)
            mid = min(mid, actual_mid)
            dist = min(dist, actual_dist)
        elif force >= HARD_FORCE_N:
            # Hard contact: proximal should yield.
            prox = min(prox, actual_prox - 0.04)
            # Allow middle/distal to continue, but not violently beyond current.
            mid = min(mid, actual_mid + 0.04)
            dist = min(dist, actual_dist + 0.03)
        elif force >= CONTACT_FORCE_N:
            # Normal contact: proximal holds/yields, middle/distal can wrap.
            prox = min(prox, actual_prox + PROXIMAL_YIELD_MARGIN)

        prox = clamp(prox, 0.0, math.pi / 2.0)
        mid = clamp(mid, 0.0, math.pi / 2.0)
        dist = clamp(dist, 0.0, math.pi / 4.0)

        return prox, mid, dist

    def build_sim_positions(self):
        hw = dict(zip(HARDWARE_ORDER, self.current_hw))

        thumb_mcp, thumb_pip, thumb_dip = thumb_finger_stages(hw["thumb_flexion_motor"])
        index_prox, index_mid, index_dist = normal_finger_stages(hw["index_flexion_motor"])
        middle_prox, middle_mid, middle_dist = normal_finger_stages(hw["middle_flexion_motor"])
        ring_prox, ring_mid, ring_dist = normal_finger_stages(hw["ring_small_flexion_motor"])
        small_prox, small_mid, small_dist = ring_prox, ring_mid, ring_dist

        thumb_mcp, thumb_pip, thumb_dip = self.apply_joint_compliance(
            "thumb", thumb_mcp, thumb_pip, thumb_dip
        )
        index_prox, index_mid, index_dist = self.apply_joint_compliance(
            "index", index_prox, index_mid, index_dist
        )
        middle_prox, middle_mid, middle_dist = self.apply_joint_compliance(
            "middle", middle_prox, middle_mid, middle_dist
        )
        ring_prox, ring_mid, ring_dist = self.apply_joint_compliance(
            "ring", ring_prox, ring_mid, ring_dist
        )
        small_prox, small_mid, small_dist = self.apply_joint_compliance(
            "small", small_prox, small_mid, small_dist
        )

        return [
            wrist_rotation_ticks_to_rad(hw["forearm:1--base:1"]),
            wrist_adduction_ticks_to_rad(hw["palm_axis:1--forearm:1"]),
            wrist_flexion_ticks_to_rad(hw["palm_assembly:1--palm_axis:1"]),
            thumb_adduction_ticks_to_rad(hw["thumb_adduction_motor"]),

            thumb_mcp,
            thumb_pip,
            thumb_dip,

            index_prox,
            index_mid,
            index_dist,

            middle_prox,
            middle_mid,
            middle_dist,

            ring_prox,
            ring_mid,
            ring_dist,

            small_prox,
            small_mid,
            small_dist,
        ]

    def control_loop(self):
        self.update_virtual_motor_ticks()
        sim_positions = self.build_sim_positions()

        traj = JointTrajectory()
        traj.joint_names = list(SIM_JOINT_ORDER)

        point = JointTrajectoryPoint()
        point.positions = sim_positions
        point.time_from_start.sec = 0
        point.time_from_start.nanosec = 120_000_000

        traj.points.append(point)
        self.pub.publish(traj)


def main():
    rclpy.init()
    node = RH8DCompliantCommandAdapter()

    try:
        rclpy.spin(node)
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == "__main__":
    main()
